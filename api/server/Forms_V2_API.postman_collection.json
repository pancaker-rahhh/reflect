{
	"info": {
		"name": "Forms V2 API - Complete Flow",
		"description": "Complete API flow for testing Forms V2: User signup → Create org → Create project → Create form → Submit response",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"full_name\": \"Test User\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/register",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "register"]
						}
					},
					"response": []
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.environment.set(\"access_token\", jsonData.access_token);",
									"    pm.environment.set(\"user_id\", jsonData.user_id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "login"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Organization",
			"item": [
				{
					"name": "Create Organization",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    pm.environment.set(\"org_id\", jsonData.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"My Test Organization\",\n  \"description\": \"Organization for testing Forms V2\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/organizations",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "organizations"]
						}
					},
					"response": []
				},
				{
					"name": "Get Organization",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/organizations/{{org_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "organizations", "{{org_id}}"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Project",
			"item": [
				{
					"name": "Create Project",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    pm.environment.set(\"project_id\", jsonData.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Test Project\",\n  \"description\": \"Project for testing forms\",\n  \"organization_id\": \"{{org_id}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/projects",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "projects"]
						}
					},
					"response": []
				},
				{
					"name": "Get Project",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/projects/{{project_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "projects", "{{project_id}}"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "4. Forms V2 - Authenticated",
			"item": [
				{
					"name": "Create Form - Simple",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    pm.environment.set(\"form_id\", jsonData.id);",
									"    pm.environment.set(\"public_link\", jsonData.public_link);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"project_id\": \"{{project_id}}\",\n  \"name\": \"Customer Feedback Form\",\n  \"description\": \"Collect customer feedback\",\n  \"is_active\": true,\n  \"fields\": [\n    {\n      \"field_type\": \"text\",\n      \"field_key\": \"name\",\n      \"label\": \"Your Name\",\n      \"is_required\": true,\n      \"max_length\": 100,\n      \"order_index\": 0\n    },\n    {\n      \"field_type\": \"text\",\n      \"field_key\": \"email\",\n      \"label\": \"Email Address\",\n      \"is_required\": true,\n      \"max_length\": 255,\n      \"order_index\": 1\n    },\n    {\n      \"field_type\": \"choice\",\n      \"field_key\": \"satisfaction\",\n      \"label\": \"How satisfied are you?\",\n      \"is_required\": true,\n      \"choices\": [\"Very Satisfied\", \"Satisfied\", \"Neutral\", \"Dissatisfied\", \"Very Dissatisfied\"],\n      \"multiple\": false,\n      \"order_index\": 2\n    },\n    {\n      \"field_type\": \"text\",\n      \"field_key\": \"comments\",\n      \"label\": \"Additional Comments\",\n      \"is_required\": false,\n      \"max_length\": 1000,\n      \"order_index\": 3\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v2/forms/",
							"host": ["{{base_url}}"],
							"path": ["api", "v2", "forms", ""]
						}
					},
					"response": []
				},
				{
					"name": "Create Form - Complex (All Field Types)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"project_id\": \"{{project_id}}\",\n  \"name\": \"Product Survey - All Field Types\",\n  \"description\": \"Comprehensive product survey\",\n  \"is_active\": true,\n  \"fields\": [\n    {\n      \"field_type\": \"text\",\n      \"field_key\": \"full_name\",\n      \"label\": \"Full Name\",\n      \"is_required\": true,\n      \"max_length\": 150,\n      \"order_index\": 0\n    },\n    {\n      \"field_type\": \"number\",\n      \"field_key\": \"age\",\n      \"label\": \"Age\",\n      \"is_required\": false,\n      \"min_value\": 18,\n      \"max_value\": 120,\n      \"order_index\": 1\n    },\n    {\n      \"field_type\": \"number\",\n      \"field_key\": \"rating\",\n      \"label\": \"Product Rating (1-5)\",\n      \"is_required\": true,\n      \"min_value\": 1,\n      \"max_value\": 5,\n      \"default_value\": 3,\n      \"order_index\": 2\n    },\n    {\n      \"field_type\": \"choice\",\n      \"field_key\": \"product_category\",\n      \"label\": \"Product Category\",\n      \"is_required\": true,\n      \"choices\": [\"Electronics\", \"Clothing\", \"Food\", \"Books\", \"Other\"],\n      \"multiple\": false,\n      \"order_index\": 3\n    },\n    {\n      \"field_type\": \"choice\",\n      \"field_key\": \"features_used\",\n      \"label\": \"Features You Used (select multiple)\",\n      \"is_required\": false,\n      \"choices\": [\"Feature A\", \"Feature B\", \"Feature C\", \"Feature D\"],\n      \"multiple\": true,\n      \"order_index\": 4\n    },\n    {\n      \"field_type\": \"text\",\n      \"field_key\": \"feedback\",\n      \"label\": \"Your Feedback\",\n      \"is_required\": false,\n      \"max_length\": 2000,\n      \"order_index\": 5\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v2/forms/",
							"host": ["{{base_url}}"],
							"path": ["api", "v2", "forms", ""]
						}
					},
					"response": []
				},
				{
					"name": "Get Form by ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v2/forms/{{form_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "v2", "forms", "{{form_id}}"]
						}
					},
					"response": []
				},
				{
					"name": "List Forms",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v2/forms/?project_id={{project_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "v2", "forms", ""],
							"query": [
								{
									"key": "project_id",
									"value": "{{project_id}}"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Update Form",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Updated Form Name\",\n  \"description\": \"Updated description\",\n  \"is_active\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v2/forms/{{form_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "v2", "forms", "{{form_id}}"]
						}
					},
					"response": []
				},
				{
					"name": "Deactivate Form",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"is_active\": false\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v2/forms/{{form_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "v2", "forms", "{{form_id}}"]
						}
					},
					"response": []
				},
				{
					"name": "Add Field to Form",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"field_type\": \"text\",\n  \"field_key\": \"phone\",\n  \"label\": \"Phone Number\",\n  \"is_required\": false,\n  \"max_length\": 20,\n  \"order_index\": 10\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v2/forms/{{form_id}}/fields",
							"host": ["{{base_url}}"],
							"path": ["api", "v2", "forms", "{{form_id}}", "fields"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "5. Forms V2 - Public (No Auth)",
			"item": [
				{
					"name": "Get Form by Public Link",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v2/forms/public/{{public_link}}",
							"host": ["{{base_url}}"],
							"path": ["api", "v2", "forms", "public", "{{public_link}}"]
						},
						"description": "Public endpoint - no authentication required. Use this to render the form to end users."
					},
					"response": []
				},
				{
					"name": "Submit Form Response - Success",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"answers\": {\n    \"name\": \"John Doe\",\n    \"email\": \"john.doe@example.com\",\n    \"satisfaction\": \"Very Satisfied\",\n    \"comments\": \"Great product! Really enjoyed using it.\"\n  },\n  \"submitter_name\": \"John Doe\",\n  \"submitter_email\": \"john.doe@example.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v2/forms/public/{{public_link}}/submit",
							"host": ["{{base_url}}"],
							"path": ["api", "v2", "forms", "public", "{{public_link}}", "submit"]
						},
						"description": "Submit a form response. Returns simple success message."
					},
					"response": []
				},
				{
					"name": "Submit Form Response - Missing Required Field",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"answers\": {\n    \"name\": \"Jane Doe\"\n  },\n  \"submitter_name\": \"Jane Doe\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v2/forms/public/{{public_link}}/submit",
							"host": ["{{base_url}}"],
							"path": ["api", "v2", "forms", "public", "{{public_link}}", "submit"]
						},
						"description": "This should fail with 400 error because required 'email' and 'satisfaction' fields are missing."
					},
					"response": []
				},
				{
					"name": "Submit Form Response - Multiple Submissions",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"answers\": {\n    \"name\": \"Alice Smith\",\n    \"email\": \"alice@example.com\",\n    \"satisfaction\": \"Satisfied\",\n    \"comments\": \"Good overall experience.\"\n  },\n  \"submitter_name\": \"Alice Smith\",\n  \"submitter_email\": \"alice@example.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v2/forms/public/{{public_link}}/submit",
							"host": ["{{base_url}}"],
							"path": ["api", "v2", "forms", "public", "{{public_link}}", "submit"]
						},
						"description": "Submit another response - same form can receive multiple submissions."
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000",
			"type": "string"
		}
	]
}
