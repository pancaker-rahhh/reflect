# Database Configuration (Local PostgreSQL)
POSTGRES_USER=reflect_dev_user
POSTGRES_PASSWORD=reflect_dev_pass
POSTGRES_DB=reflect_dev_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database URL (constructed from above)
DATABASE_URL=postgresql+asyncpg://reflect_dev_user:reflect_dev_pass@localhost:5432/reflect_dev_db

# Supabase Configuration (Auth Only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Application Settings
APP_NAME=Reflect API
APP_VERSION=0.1.0
API_PREFIX=/api/v1
DEBUG=true

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (comma-separated values)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_HEADERS=*

# Frontend & Email Configuration
FRONTEND_URL=http://localhost:5713
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=reflect

# Task Backend
TASK_BACKEND=fastapi  # Options: fastapi, celery, vercel

# Logging
LOG_LEVEL=INFO

# Optional: Monitoring (Free Tiers)
# AXIOM_TOKEN=
# AXIOM_DATASET=
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://app.posthog.com
# SENTRY_DSN=

# Cloudflare R2 Configuration
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=reflect-widgets
CDN_BASE_URL=https://your-domain.r2.dev
CDN_ZONE_ID=your_cloudflare_zone_id
CDN_API_TOKEN=your_cloudflare_api_token