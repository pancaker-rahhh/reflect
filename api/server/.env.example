# Database Configuration (Local PostgreSQL)
POSTGRES_USER=feedbask_user
POSTGRES_PASSWORD=feedbask_pass
POSTGRES_DB=feedbask_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database URL (constructed from above)
DATABASE_URL=postgresql+asyncpg://feedbask_user:feedbask_pass@localhost:5432/feedbask_db

# Supabase Configuration (Auth Only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# Application Settings
APP_NAME=Feedbask API
APP_VERSION=0.1.0
API_PREFIX=/api/v1
DEBUG=true

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (comma-separated values)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_HEADERS=*

# Task Backend
TASK_BACKEND=fastapi  # Options: fastapi, celery, vercel

# Logging
LOG_LEVEL=INFO

# Optional: Monitoring (Free Tiers)
# AXIOM_TOKEN=
# AXIOM_DATASET=
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://app.posthog.com
# SENTRY_DSN=