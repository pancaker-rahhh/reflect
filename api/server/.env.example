# Database Configuration (Local PostgreSQL)
POSTGRES_USER=reflect_dev_user
POSTGRES_PASSWORD=reflect_dev_pass
POSTGRES_DB=reflect_dev_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database URL (constructed from above)
DATABASE_URL=postgresql+asyncpg://reflect_dev_user:reflect_dev_pass@localhost:5432/reflect_dev_db

# Supabase Configuration (Auth Only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Application Settings
APP_NAME=Reflect API
APP_VERSION=0.1.0
API_PREFIX=/api/v1
DEBUG=true

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (comma-separated values)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_HEADERS=*

# Frontend & Email Configuration
FRONTEND_URL=http://localhost:5713
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=reflect

# Email Provider Configuration
# Options: mock (for development), aws_ses, resend
EMAIL_PROVIDER=mock
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_DELAY=5

# AWS SES Configuration (required if EMAIL_PROVIDER=aws_ses)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# SES_CONFIGURATION_SET=your_configuration_set  # Optional

# Resend Configuration (required if EMAIL_PROVIDER=resend)
# RESEND_API_KEY=your_resend_api_key

# Task Backend
TASK_BACKEND=fastapi  # Options: fastapi, celery, vercel

# Logging
LOG_LEVEL=INFO

# Optional: Monitoring (Free Tiers)
# AXIOM_TOKEN=
# AXIOM_DATASET=
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://app.posthog.com
# SENTRY_DSN=